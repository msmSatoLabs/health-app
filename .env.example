# Copy this file to .env and fill in the two values from
# Supabase > Connect (see SETUP.md). The key is SUPABASE_PUBLISHABLE_KEY
# (sb_publishable_...), or the "anon public" key on older projects.
# Never use the secret / service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key
